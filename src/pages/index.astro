---
import { SeedTool } from "@/components/SeedTool";
import "../styles/global.css";

const siteUrl = Astro.site ?? new URL("/", Astro.url);
const canonicalUrl = new URL("/", siteUrl).toString();
const socialImageUrl = new URL("/og.png", siteUrl).toString();
const title = "OfflineSeeds";
const description =
  "Create a repeatable printable card-to-word lookup from a shuffle code.";
const socialImageAlt =
  "OfflineSeeds card-to-word lookup with playing cards and a printable grid.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main
      class="mx-auto w-full max-w-6xl px-4 pt-6 pb-10 print:m-0 print:block print:w-auto print:overflow-visible print:p-0 md:px-6 md:pt-10 md:pb-12"
    >
      <header
        class="grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-3 border-b-[3px] border-ink-1 pb-[1.1rem] [border-bottom-style:double] print:hidden"
      >
        <span
          class="grid h-[3.1rem] w-[2.35rem] place-items-center rounded-[0.3rem] border border-rule-strong bg-paper-0 font-display text-2xl leading-none text-ink-1 shadow-card"
          aria-hidden="true">♣</span
        >
        <h1
          class="m-0 font-display text-[2.1rem] font-normal tracking-[-0.015em]"
        >
          OfflineSeeds
        </h1>
        <p class="col-span-full m-0 max-w-[34rem] text-note leading-normal text-ink-2">
          Create and download a repeatable card-to-word lookup.
        </p>
      </header>
      <SeedTool client:load />
      <footer
        class="mt-8 border-t border-rule pt-6 text-center text-note text-ink-3 print:hidden [&_a]:text-ink-2 [&_a]:underline [&_a]:decoration-rule-strong [&_a]:underline-offset-[3px] [&_a]:transition-[color,text-decoration-color] [&_a]:duration-150 [&_a]:ease-[ease] [&_a:hover]:text-ink-1 [&_a:hover]:decoration-current [&_a:focus-visible]:text-ink-1 [&_a:focus-visible]:decoration-current"
      >
        <a href="https://github.com/bitcoinppl/offlineseeds">Source on GitHub</a>.
        Card-pair layout from <a
          href="https://github.com/jimbojw/seed-picker-solitaire"
          >SeedPicker Solitaire</a
        >.
      </footer>
    </main>
  </body>
</html>
