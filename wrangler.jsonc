{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offlineseeds",
  "compatibility_date": "2026-08-05",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "offlineseeds.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
